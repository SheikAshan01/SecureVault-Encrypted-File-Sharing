# Dependencies
node_modules/
**/node_modules/

# Production builds
dist/
**/dist/
dist-ssr/

# Environment files (never commit secrets)
.env
**/.env
.env.local
.env.*.local
!.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime file uploads and dynamic data
backend/uploads/encrypted/*
!backend/uploads/encrypted/.gitkeep
backend/data/db.json
!backend/data/.gitkeep

# Editor & OS files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
